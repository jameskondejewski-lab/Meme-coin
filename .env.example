# All optional. Without them the tool uses public endpoints, which are rate-limited.
# Use a dedicated RPC (Helius, Triton, QuickNode, ...) for getTokenLargestAccounts,
# which public mainnet-beta RPC often throttles.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# CoinGecko demo key (sent as x-cg-demo-api-key)
COINGECKO_API_KEY=
# Jupiter: keyless lite-api.jup.ag by default (being phased out by Jupiter).
# Setting a key (portal.jup.ag) switches the default base to https://api.jup.ag.
JUPITER_API_KEY=
# JUPITER_API_BASE=https://api.jup.ag
